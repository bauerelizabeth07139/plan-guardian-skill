{
  "name": "dsh-plan-guardian",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that bundles the plan-guardian skill: a mandatory 7-step plan with binary acceptance criteria, execution through worker subagents, and completion validated by independent memoryless verifier subagents that report PASS or FAIL with evidence.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/plan-guardian-skill.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/plan-guardian-skill#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/plan-guardian-skill/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "skills",
    "references",
    "scripts",
    "agents",
    "test",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "AGENTS.md",
    "AGENTS.global.md"
  ],
  "engines": {
    "node": ">=22",
    "python": ">=3.10",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node --import ./test/hooks.mjs test/skill.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skill",
    "planning",
    "verification",
    "subagent",
    "acceptance-criteria"
  ]
}
